#!/usr/bin/env sh
# Run a command inside the project's PHP 8.3 toolchain image.
set -e

IMAGE="${SCP_WHMCS_PHP_IMAGE:-scp-whmcs-integration-php:8.3}"
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(dirname "$BIN_DIR")"

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  docker build -q -t "$IMAGE" -f "$BIN_DIR/Dockerfile" "$BIN_DIR" >/dev/null
fi

# Run as the invoking user so files written into the mounted checkout
# (vendor/, the zip) are owned by the host user and the mount is writable
# regardless of the uid baked into the image.
exec docker run --rm \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  -e COMPOSER_HOME=/tmp/composer \
  -v "$ROOT_DIR":/app -w /app "$IMAGE" "$@"
